/*
 * 疑似エフェクトの定義から .ffx（アニメーションプリセット）のバイト列を作る。
 * 事前に binary.jsxinc を読み込んでおくこと。
 *
 * 定義の例:
 * {
 *   name: "Zabuton",               // エフェクトコントロールに表示される名前
 *   matchName: "Pseudo/Zabuton",   // 内部名。エフェクトごとに固有にする
 *   params: [
 *     { type: "slider", name: "Padding", validMin: 0, validMax: 5000,
 *       sliderMin: 0, sliderMax: 5000, value: 0, precision: 0 },
 *     { type: "color", name: "BG_Color", value: [255, 0, 0] },
 *     { type: "group", name: "Detail", params: [ ... ] }
 *   ]
 * }
 *
 * 項目の種類と設定（共通: name, invisible, hold）
 *   slider   : value, sliderMin, sliderMax, validMin, validMax, precision, percent, pixel
 *   angle    : value（度。1回転=360）
 *   checkbox : value（true/false）, label（チェックボックス横の文字）
 *   color    : value（[R, G, B] 0〜255）
 *   point    : value（[X, Y] レイヤーサイズに対する%）
 *   point3d  : value（[X, Y, Z] レイヤーサイズに対する%）
 *   popup    : items（["A", "B"]）, value（1から数えた番号）
 *   layer    : （初期値は「なし」）
 *   label    : dim（文字を薄く表示）
 *   group    : params（中に入れる項目）
 *
 * バイナリの意味は、AE が書き出した .ffx を読み解いて合わせている。
 * 意味が分かっていないバイトは見本の値をそのまま使う。
 */
var CK_FFXWriter = (function (B) {
  // --- 見本からそのまま使っている固定値 -------------------------------
  var HEAD = "00000003 00000044 00000001 01000000";
  var BESO =
    "00000001 00000001 00000000 00005da8 001df852 00000000 00640064 00640064" +
    "3ff00000 00000000 3ff00000 00000000 00000000 ffffffff";

  // tdb4（ストリームの設定, 124バイト）。{H} は Hold キーフレームのフラグが入る位置
  var TDB4_ROOT =
    "db990001 00010000 00010000 00000258 3f1a36e2 eb1c432d 3ff00000 00000000" +
    "3ff00000 00000000 3ff00000 00000000 3ff00000 00000000 00000004 04c0c0c0" +
    "ffc0c0c0 00000000 80000000";
  var TDB4_SIMPLE = "bd990001 00010000 0001{H} 00005da8";
  var TDB4_COLOR = "bd990004 00070001 0002ff{h}00005da8";
  var TDB4_DISCRETE =
    "db990001 00010000 0001{H} 00005da8 3f1a36e2 eb1c432d 3ff00000 00000000" +
    "3ff00000 00000000 3ff00000 00000000 3ff00000 00000000 00000004 04000000";
  var TDB4_POINT =
    "db990002 000f0003 ffffffff 00005da8 3d9b7cdf d9d7bdbc 3ff00000 00000000" +
    "3ff00000 00000000 3ff00000 00000000 3ff00000 00000000 00000004 06000000" +
    "00000000 00000000 00000000 00000001";
  var TDB4_POINT3D =
    "db990003 000f0003 ffffffff 00005da8 3d9b7cdf d9d7bdbc 3ff00000 00000000" +
    "3ff00000 00000000 3ff00000 00000000 3ff00000 00000000 00000008 09000000" +
    "00000000 00000000 00000000 00000001";

  // pard の種類コード
  var PARD_TYPE = {
    layer: 0x00,
    angle: 0x03,
    checkbox: 0x04,
    color: 0x05,
    point: 0x06,
    popup: 0x07,
    slider: 0x0a,
    groupStart: 0x0d,
    groupEnd: 0x0e,
    point3d: 0x12
  };

  var FLAG_DIM = 0x20; // ラベルの文字を薄く表示
  var FLAG_INVISIBLE_IN_GROUP = 0x200; // グループ内の非表示項目（見本ではグループ内だけに付いていた）
  var TDPI_GROUP = 0x0e;

  // 点の現在値（cdat）はピクセルで保存される。% からの換算に使う基準サイズ
  var POINT_REF = [1920, 1080];

  function hex(h) {
    return B.fromHex(h);
  }

  function pad(bytes, len) {
    return bytes + B.zeros(len - bytes.length);
  }

  function fixed(v) {
    // 16.16 固定小数
    return B.u32(Math.round(v * 65536) >>> 0);
  }

  function tdmn(matchName) {
    return B.chunk("tdmn", B.fixedString(matchName, 40));
  }

  function tdsn(name) {
    return B.chunk("tdsn", name + "\x00");
  }

  function paramMatchName(def, index) {
    var n = "000" + index;
    return def.matchName + "-" + n.substring(n.length - 4);
  }

  function tdb4(template, hold) {
    var s = template.replace("{H}", hold ? "0004" : "00ff").replace("{h}", hold ? "04 " : "ff ");
    return B.chunk("tdb4", pad(hex(s), 124));
  }

  function cdat(values, len) {
    var s = "";
    for (var i = 0; i < values.length; i++) s += B.f64(values[i]);
    return B.chunk("cdat", pad(s, len));
  }

  // --- 定義を AE の並び（グループは開始／終了の2項目）に展開する ---------
  function flatten(params, out, depth) {
    depth = depth || 0;
    for (var i = 0; i < params.length; i++) {
      var p = params[i];
      if (p.type === "group") {
        out.push({ kind: "groupStart", p: p, depth: depth });
        flatten(p.params || [], out, depth + 1);
        out.push({ kind: "groupEnd", p: p });
      } else if (p.type === "label") {
        out.push({ kind: "label", p: p });
        out.push({ kind: "groupEnd", p: p });
      } else {
        out.push({ kind: p.type, p: p, depth: depth });
      }
    }
    return out;
  }

  // --- pard: 項目の定義（148バイト） ---------------------------------
  function pard(item) {
    var p = item.p;
    var kind = item.kind;
    var flags = kind === "label" && p.dim ? FLAG_DIM : 0;
    if (p.invisible && item.depth > 0 && kind !== "groupEnd") flags |= FLAG_INVISIBLE_IN_GROUP;
    var type = kind === "label" ? PARD_TYPE.groupStart : PARD_TYPE[kind];
    if (type === undefined) throw new Error("未対応の種類です: " + kind);
    var name = kind === "groupEnd" ? "" : p.name;
    var s = B.zeros(4) + B.u32(flags) + B.zeros(4) + B.u32(type) + B.fixedString(name, 32); // 0-47
    var v = p.value;

    if (kind === "slider") {
      s += B.zeros(104 - 48);
      s += B.f32(p.validMin) + B.f32(p.validMax) + B.f32(p.sliderMin) + B.f32(p.sliderMax);
      s += B.f32(v || 0);
      s += B.u16(p.precision || 0) + B.u16((p.percent ? 1 : 0) | (p.pixel ? 2 : 0));
    } else if (kind === "angle") {
      s += B.zeros(12) + fixed(v || 0);
    } else if (kind === "checkbox") {
      s += B.zeros(12) + B.u8(v ? 1 : 0);
    } else if (kind === "color") {
      s += B.zeros(8) + hex("0000ffff") + B.u8(255) + B.u8(v[0]) + B.u8(v[1]) + B.u8(v[2]);
    } else if (kind === "point") {
      // 56,60: 割合（1.0 = 100%）, 68,72: %（どちらも 16.16 固定小数）
      s += B.zeros(8) + fixed(v[0] / 100) + fixed(v[1] / 100) + B.zeros(4) + fixed(v[0]) + fixed(v[1]);
    } else if (kind === "point3d") {
      s += B.zeros(8);
      s += B.f64(v[0] / 100) + B.f64(v[1] / 100) + B.f64(v[2] / 100);
      s += B.f64(v[0]) + B.f64(v[1]) + B.f64(v[2]);
    } else if (kind === "popup") {
      s += B.zeros(8) + B.u32(v) + B.u16(p.items.length) + B.u16(v);
    } else if (kind === "layer") {
      s += B.u32(2);
    }

    var out = B.chunk("pard", pad(s, 148));
    if (kind === "checkbox") out += B.chunk("pdnm", (p.label || "") + "\x00");
    if (kind === "popup") out += B.chunk("pdnm", p.items.join("|") + "\x00");
    return out;
  }

  function rootPard() {
    return B.chunk(
      "pard",
      pad(B.zeros(48) + B.u32(2) + B.zeros(4) + B.u32(0x0e) + B.zeros(68) + B.u32(0xffffffff), 148)
    );
  }

  // --- tdbs: 項目の現在値 ---------------------------------------------
  function tdbs(item, def) {
    var p = item.p;
    var kind = item.kind;
    var v = p.value;
    var hidden = kind !== "groupEnd" && p.invisible;
    var body = B.chunk("tdsb", B.u32(hidden ? 3 : 1));
    body += tdsn(kind === "groupEnd" ? def.name : p.name);

    if (kind === "slider") {
      body += tdb4(TDB4_SIMPLE, p.hold) + cdat([v || 0], 40);
      body += B.chunk("tdum", B.f64(p.sliderMin)) + B.chunk("tduM", B.f64(p.sliderMax));
    } else if (kind === "angle") {
      body += tdb4(TDB4_SIMPLE, p.hold) + cdat([v || 0], 40);
    } else if (kind === "checkbox") {
      body += tdb4(TDB4_DISCRETE, p.hold) + cdat([v ? 1 : 0], 40);
    } else if (kind === "color") {
      body += tdb4(TDB4_COLOR, p.hold) + cdat([255, v[0], v[1], v[2]], 96);
    } else if (kind === "point") {
      var cur = p.current || [(POINT_REF[0] * v[0]) / 100, (POINT_REF[1] * v[1]) / 100];
      body += tdb4(TDB4_POINT) + cdat(cur, 48);
    } else if (kind === "point3d") {
      var cur3 = p.current || [
        (POINT_REF[0] * v[0]) / 100,
        (POINT_REF[1] * v[1]) / 100,
        (POINT_REF[1] * v[2]) / 100
      ];
      body += tdb4(TDB4_POINT3D) + cdat(cur3, 72);
    } else if (kind === "popup") {
      body += tdb4(TDB4_DISCRETE, p.hold) + cdat([v], 40);
    } else if (kind === "layer") {
      body += tdb4(TDB4_DISCRETE, p.hold) + cdat([], 40) + B.chunk("tdpi", B.u32(0));
    } else if (kind === "groupStart" || kind === "label") {
      body += tdb4(TDB4_SIMPLE, true) + cdat([], 40);
    } else if (kind === "groupEnd") {
      body += tdb4(TDB4_SIMPLE, true) + cdat([], 40) + B.chunk("tdpi", B.u32(TDPI_GROUP));
    }
    return B.list("tdbs", body);
  }

  function rootTdbs() {
    return B.list(
      "tdbs",
      B.chunk("tdsb", B.u32(3)) +
        tdsn("") +
        B.chunk("tdb4", pad(hex(TDB4_ROOT), 124)) +
        cdat([], 40) +
        B.chunk("tdpi", B.u32(TDPI_GROUP))
    );
  }

  function effectPath(def) {
    return B.list(
      "tdsp",
      B.chunk("tdot", B.u32(0xffffffff)) +
        B.chunk("tdpl", B.u32(2)) +
        B.list("tdsi", B.chunk("tdix", B.u32(0xffffffff)) + tdmn("ADBE Effect Parade")) +
        B.list("tdsi", B.chunk("tdix", B.u32(0)) + tdmn(def.matchName))
    );
  }

  function endPath() {
    return B.list(
      "tdsp",
      B.chunk("tdot", B.u32(0xffffffff)) +
        B.chunk("tdpl", B.u32(1)) +
        B.list("tdsi", B.chunk("tdix", B.u32(0xffffffff)) + tdmn("ADBE End of path sentinel"))
    );
  }

  function build(def) {
    var items = flatten(def.params, []);
    var i;

    var parT = B.chunk("parn", B.u32(items.length + 1));
    parT += tdmn(paramMatchName(def, 0)) + rootPard();
    for (i = 0; i < items.length; i++) {
      parT += tdmn(paramMatchName(def, i + 1)) + pard(items[i]);
    }

    var tdgp = B.chunk("tdsb", B.u32(1)) + tdsn(def.name);
    tdgp += tdmn(paramMatchName(def, 0)) + rootTdbs();
    for (i = 0; i < items.length; i++) {
      tdgp += tdmn(paramMatchName(def, i + 1)) + tdbs(items[i], def);
    }
    tdgp += tdmn("ADBE Group End");

    var sspc = B.chunk("fnam", B.zeros(48)) + B.list("parT", parT) + B.list("tdgp", tdgp);
    var besc =
      B.chunk("beso", hex(BESO)) + effectPath(def) + tdsn(def.name) + endPath() + B.list("sspc", sspc);

    return B.chunk("RIFX", "FaFX" + B.chunk("head", hex(HEAD)) + B.list("besc", besc));
  }

  return { build: build, flatten: flatten };
})(CK_Binary);
